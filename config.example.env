# Copy to config.env and fill in. config.env is baked into the installer ISO.

# WiFi used by the live installer and the installed system (leave empty for Ethernet only)
WIFI_SSID=
WIFI_PASS=

# Fixed LAN IP of the coordinator (first laptop installed). Reserve it in your router.
COORD_LAN_IP=192.168.1.50

# WireGuard mesh
WG_SUBNET=10.66.0.0/24
WG_PORT=51820

# Which network WireGuard traffic uses between two nodes:
#   auto  switch when both nodes have a cable in their Ethernet port, else WiFi/router
#   lan   always the WiFi/router network
WG_TRANSPORT=auto

# Fixed IPs on the Ethernet port (auto mode). Node 10.66.0.N gets 172.16.66.N.
# Works on an isolated switch and on a switch connected to the router.
SWITCH_SUBNET=172.16.66.0/24

# Extra ports open to other servers over the mesh only (SSH is always open),
# e.g. "8080/tcp 53/udp". Nothing extra is ever opened to WiFi/router.
MESH_PORTS=

# Optional tool bundles: docker go rust cpp neovim (always installed: ssh,
# git, cron, tmux, htop, curl, rsync, ripgrep, fzf and other basics)
TOOLS="docker go rust cpp neovim"
# Any other Arch packages, space-separated
EXTRA_PACKAGES=

# Admin login on every node (SSH key only, no passwords)
USERNAME=admin
ADMIN_SSH_PUBKEY="ssh-ed25519 AAAA... you@desktop"

TIMEZONE=UTC
