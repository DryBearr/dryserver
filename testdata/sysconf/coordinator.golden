# No LLMNR or mDNS: both answer name lookups from anyone on the network
# and are a common way to poison names on a LAN.
[Resolve]
LLMNR=no
MulticastDNS=no
===== /etc/systemd/zram-generator.conf (0644)
# Compressed swap in RAM. No swap partition, so nothing from memory is
# written unencrypted to disk.
[zram0]
zram-size = min(ram / 2, 8192)
compression-algorithm = zstd
