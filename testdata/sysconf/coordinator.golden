# dryserver: the ingress runs on every machine, so it does not go down
# with the one server that happened to hold it.
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |-
    deployment:
      kind: DaemonSet
===== /var/lib/rancher/k3s/server/manifests/dryserver-coredns.yaml (0600)
# dryserver: the cluster's DNS keeps at least one copy through a drain.
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: coredns
  namespace: kube-system
spec:
  minAvailable: 1
  selector:
    matchLabels:
      k8s-app: kube-dns
