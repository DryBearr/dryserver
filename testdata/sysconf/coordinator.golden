===== /etc/systemd/system/dryserver-update-guard.service (0644)
# dryserver: after a restart, an update that was not confirmed in time
# (or never finished applying) is reverted before the kernel settings, the
# firewall, the network and SSH start; one whose window is still open gets
# its revert timer back.
[Unit]
Description=Revert an unconfirmed dryserver update after a restart
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target shutdown.target systemd-sysctl.service nftables.service systemd-networkd.service sshd.service wg-quick@wg0.service k3s.service dryserver-sync.timer
Conflicts=shutdown.target
ConditionPathExists=/var/lib/dryserver-update/pending.json

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/usr/local/bin/dryserver.prev update guard --boot || /usr/local/bin/dryserver update guard --boot'
TimeoutStartSec=5min

[Install]
WantedBy=sysinit.target
===== /etc/initcpio/post/dryserver-boot (0755)
#!/bin/sh
# dryserver: mkinitcpio runs this after it made a boot image. A unified
# kernel image made under its staging name is checked, flushed to disk and
# renamed into place, counted when a fallback kernel is installed. See
# `dryserver boot status`.
exec /usr/local/bin/dryserver boot place "$@"
===== /etc/pacman.d/hooks/55-dryserver-boot-mark.hook (0644)
# dryserver: a kernel is about to be replaced or removed, and with it its
# modules. Its boot image gets one more try only, so a power cut before the
# new image is made does not leave a kernel without modules as the one that
# starts: it fails its boot check and the fallback kernel starts.
[Trigger]
Type = Path
Operation = Remove
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Giving the boot images of replaced kernels one more try...
When = PreTransaction
Exec = /usr/local/bin/dryserver boot mark
NeedsTargets
===== /etc/systemd/system/dryserver-boot-check.service (0644)
[Unit]
Description=Check that a newly installed kernel works
Documentation=man:systemd-bless-boot.service(8)
# Pulled in by boot-complete.target, which systemd-bless-boot pulls in only
# when the boot loader counts this boot (a new kernel image). Only signs
# from this machine itself count: a brain, mesh or internet that is down
# must never make a good kernel bad. So nothing here waits for them, nor
# for multi-user.target, which waits for k3s, which waits for the brain.
# The firewall is loaded first: a kernel that cannot load it fails.
After=local-fs.target nftables.service sshd.service systemd-networkd.service
Before=boot-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/dryserver boot check
StandardOutput=journal+console
TimeoutStartSec=5min
===== /etc/systemd/system/boot-complete.target.d/10-dryserver.conf (0644)
# dryserver: a counted boot is good once dryserver's boot check passed.
[Unit]
Requires=dryserver-boot-check.service
===== /etc/systemd/system.conf.d/10-dryserver-watchdog.conf (0644)
# dryserver: a hardware watchdog, when the machine has one, restarts it when
# the kernel or systemd hangs, and a crash of systemd restarts it too, so a
# new kernel that hangs uses up its tries without someone at the machine.
[Manager]
RuntimeWatchdogSec=1min
CrashAction=reboot
===== /etc/systemd/system/emergency.service.d/10-dryserver.conf (0644)
# dryserver: nobody is at a server's console and root is locked, so emergency
# mode in the initramfs (a kernel that finds no disk, an unlock that failed)
# could only wait. It restarts the machine after 30 seconds instead: a new
# kernel that cannot boot uses up its tries and the other kernel starts.
# After the switch to the real root this does nothing.
[Service]
ExecStartPre=-/usr/bin/sh -c 'test -e /etc/initrd-release || exit 0; echo "dryserver: restarting in 30 seconds"; sleep 30; systemctl --no-block reboot'
===== /etc/cron.d/dryserver-scan (0644)
# dryserver: look for unknown devices on the network (report only).
*/15 * * * * root /usr/local/bin/dryserver scan >/dev/null 2>&1
